# Copy to .env and fill in. Every value below is a placeholder.

# --- Telegram -----------------------------------------------------------------------------
# Token from @BotFather. Never commit the real one.
BOT_TOKEN=123456789:replace-with-the-token-from-botfather
# Bot username without "@"; used to build https://t.me/<username>?start=<code>
BOT_USERNAME=example_shop_bot
# Site name shown to the user inside the bot
SITE_NAME=shop.example
# Fail fast on a hung TCP handshake to api.telegram.org (seconds)
TELEGRAM_CONNECT_TIMEOUT=5
TELEGRAM_REQUEST_TIMEOUT=15

# --- Storage ------------------------------------------------------------------------------
# redis (default) or memory (single process, for local experiments only)
STORE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# --- Login --------------------------------------------------------------------------------
# Kill switch: false stops POST /auth/telegram/start, polling and the bot flow
LOGIN_ENABLED=true
LOGIN_CODE_TTL_SECONDS=300
# Browser origins allowed to call POST /auth/telegram/start, comma separated.
# The site's own origin is always allowed; add others only if you need them.
ALLOWED_ORIGINS=https://shop.example
# Set only if your reverse proxy OVERWRITES this header with the real client IP
# (for example X-Real-IP). Leave empty to use the socket address.
CLIENT_IP_HEADER=
START_RATE_LIMIT=10
START_RATE_WINDOW_SECONDS=60
POLL_RATE_LIMIT=120
POLL_RATE_WINDOW_SECONDS=60
# Wrong deep-link codes per Telegram user before the bot stops answering
BAD_CODE_LIMIT=5
BAD_CODE_WINDOW_SECONDS=600
# false only for local development over plain http (the cookie name loses its __Host- prefix)
COOKIE_SECURE=true
SESSION_COOKIE_NAME=session
SESSION_TTL_SECONDS=2592000

# --- Pluggable parts (optional) -----------------------------------------------------------
# JSON file for the built-in in-memory directory, see examples/customers.example.json
DIRECTORY_FILE=examples/customers.example.json
# Or your own implementation: "package.module:function", called with Settings
# DIRECTORY_FACTORY=my_shop.auth:make_directory
# SESSION_ISSUER_FACTORY=my_shop.auth:make_session_issuer

# --- Notifications to a manager chat ------------------------------------------------------
# Kill switch for manager notifications
NOTIFY_ENABLED=true
# Chat id of the manager chat (the bot must be a member / the manager must press Start)
NOTIFY_CHAT_ID=-1000000000000
# Bearer token (16+ characters) that enables POST /internal/notify on the API.
# Leave empty to keep the endpoint disabled. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTIFY_API_TOKEN=
NOTIFY_MAX_ATTEMPTS=5
# Telegram allows about one message per second per chat
NOTIFY_MIN_INTERVAL_SECONDS=1

# --- Bot runtime --------------------------------------------------------------------------
# polling (default, no public URL needed) or webhook
BOT_MODE=polling
POLLING_TIMEOUT_SECONDS=20
# Webhook mode only: public https URL and a secret of 1-256 chars from A-Z a-z 0-9 _ -
# WEBHOOK_URL=https://bot.shop.example/telegram/webhook
# WEBHOOK_SECRET=replace-with-a-random-token
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081

LOG_LEVEL=INFO
